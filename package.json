{
  "name": "frappe-local",
  "productName": "Frappe Local",
  "version": "1.0.0-beta.11",
  "type": "module",
  "description": "Desktop app for managing local Frappe benches and sites.",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "vite",
    "build": "npm run typecheck && vite build",
    "release": "npm run build && npm run release:x64 && npm run release:arm64",
    "release:x64": "electron-builder --win --x64 --publish never",
    "release:arm64": "electron-builder --win --arm64 --publish never",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && node scripts/typecheck-renderer.js",
    "test": "vitest run",
    "dev:reset-state": "node scripts/reset-dev-state.js",
    "postinstall": "node scripts/download-binaries.js"
  },
  "author": "Lubus",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@iconify-json/lucide": "^1.2.103",
    "@iconify/json": "^2.2.478",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.5.0",
    "electron": "^35.1.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.25.1",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "unplugin-icons": "^23.0.1",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^3.1.2",
    "vue-router": "^4.6.4"
  },
  "dependencies": {
    "dugite": "^3.2.2",
    "electron-updater": "^6.8.9",
    "frappe-ui": "^1.0.0-beta.25",
    "vue": "^3.5.13",
    "zod": "^3.24.2"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "core-js@3.49.0": true,
    "electron@35.7.5": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "in.lubus.frappe-local",
    "productName": "Frappe Local",
    "compression": "normal",
    "directories": {
      "output": "release-artifacts"
    },
    "publish": {
      "provider": "github",
      "owner": "lubusIN",
      "repo": "frappe-local"
    },
    "files": [
      ".vite/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "resources/icons/icon.png",
        "to": "resources/icons/icon.png"
      },
      {
        "from": "resources/app-update.yml",
        "to": "resources/app-update.yml"
      }
    ],
    "mac": {
      "icon": "resources/icons/icon.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "zip",
        "dmg"
      ]
    },
    "dmg": {
      "background": "resources/dmg-background.png",
      "iconSize": 120,
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "resources/icons/icon.ico",
      "executableName": "frappe-local",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version} ${arch}.${ext}",
      "shortcutName": "Frappe Local",
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "resources/icons/icon.png",
      "target": [
        "deb",
        "rpm",
        "zip"
      ]
    }
  }
}
